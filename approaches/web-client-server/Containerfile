FROM node:24-alpine AS frontend
WORKDIR /src/frontend
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

FROM golang:1.24-alpine AS backend
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/letterpress ./cmd/server

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S letterpress \
    && adduser -S -G letterpress letterpress \
    && mkdir -p /data /app/frontend /app/licenses \
    && chown -R letterpress:letterpress /data /app
COPY --from=backend /out/letterpress /app/letterpress
COPY --from=frontend /src/frontend/dist/ /app/frontend/
COPY --from=backend /src/backend/internal/game/dictionary/LICENSE-ESDB.txt /app/licenses/ESDB.txt
ENV LETTERPRESS_ADDR=:8080 \
    LETTERPRESS_DB_PATH=/data/letterpress.db \
    LETTERPRESS_STATIC_DIR=/app/frontend \
    LETTERPRESS_LOG_LEVEL=info
USER letterpress
EXPOSE 8080
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/readyz || exit 1
ENTRYPOINT ["/app/letterpress"]
